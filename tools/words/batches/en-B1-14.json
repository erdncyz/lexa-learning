[
  {"term":"technique","meaning":"teknik, yöntem","pos":"isim","ipa":"/tekˈniːk/","example":"She uses a special technique to learn vocabulary.","exampleTr":"Kelime öğrenmek için özel bir teknik kullanıyor.","usage":"Vurgu ikinci hecededir: “tek-NİİK”.","synonyms":["method","approach"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
