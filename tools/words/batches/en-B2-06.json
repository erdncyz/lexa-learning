  {"term":"estate","meaning":"mülk, arazi","pos":"isim","ipa":"/ɪˈsteɪt/","example":"He works in real estate.","exampleTr":"Gayrimenkul sektöründe çalışıyor.","usage":"“real estate” gayrimenkul; “estate agent” emlakçı (İngiliz).","synonyms":["property","land"],"topics":["is"]},
  {"term":"estimate","meaning":"tahmin etmek; tahmin","pos":"fiil","ipa":"/ˈestɪmeɪt/","example":"Experts estimate that prices will rise.","exampleTr":"Uzmanlar fiyatların artacağını tahmin ediyor.","usage":"İsim olarak okunuş: /ˈestɪmət/; “rough estimate” kabaca tahmin.","synonyms":["guess","calculate"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"evaluate","meaning":"değerlendirmek","pos":"fiil","ipa":"/ɪˈvæljueɪt/","example":"We need to evaluate the results carefully.","exampleTr":"Sonuçları dikkatle değerlendirmemiz gerekiyor.","usage":"İsmi “evaluation”.","synonyms":["assess","judge"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"evil","meaning":"kötü, şeytani; kötülük","pos":"sıfat","ipa":"/ˈiːvl/","example":"The movie is about an evil king.","exampleTr":"Film kötü bir kral hakkında.","usage":"İsim olarak “kötülük”: “good and evil”.","synonyms":["wicked","bad"],"topics":["gunluk"]},
  {"term":"examination","meaning":"sınav; muayene","pos":"isim","ipa":"/ɪɡˌzæmɪˈneɪʃn/","example":"The doctor did a full examination.","exampleTr":"Doktor tam bir muayene yaptı.","usage":"“exam” kelimesinin resmî hâlidir.","synonyms":["exam","inspection"],"topics":["okul"]},
  {"term":"excuse","meaning":"bahane; mazur görmek","pos":"isim","ipa":"/ɪkˈskjuːs/","example":"He always has an excuse for being late.","exampleTr":"Geç kalmak için her zaman bir bahanesi var.","usage":"Fiil olarak okunuş: /ɪkˈskjuːz/; “Excuse me” affedersiniz.","synonyms":["reason","pardon"],"topics":["gunluk"]},
  {"term":"executive","meaning":"yönetici; yürütme","pos":"isim","ipa":"/ɪɡˈzekjətɪv/","example":"She's a senior executive at a bank.","exampleTr":"Bir bankada üst düzey yönetici.","usage":"“CEO” = chief executive officer.","synonyms":["manager","director"],"topics":["is"]},
