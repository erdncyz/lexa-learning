  {"term":"finance","meaning":"finans; finanse etmek","pos":"isim","ipa":"/ˈfaɪnæns/","example":"She works in finance.","exampleTr":"Finans alanında çalışıyor.","usage":"Çoğul “finances” bir kişinin mali durumu.","synonyms":["money","fund"],"topics":["is"],"exams":["IELTS","TOEFL","YDS"]},
