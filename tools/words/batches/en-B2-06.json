  {"term":"expense","meaning":"masraf, gider","pos":"isim","ipa":"/ɪkˈspens/","example":"The company pays for travel expenses.","exampleTr":"Şirket seyahat masraflarını karşılıyor.","usage":"“at the expense of” … pahasına; sıfatı “expensive”.","synonyms":["cost","spending"],"topics":["is"]},
  {"term":"exploration","meaning":"keşif","pos":"isim","ipa":"/ˌekspləˈreɪʃn/","example":"Space exploration is very expensive.","exampleTr":"Uzay keşfi çok pahalı.","usage":"Fiili “explore”.","synonyms":["discovery","investigation"],"topics":["akademik"]},
  {"term":"expose","meaning":"maruz bırakmak; ifşa etmek","pos":"fiil","ipa":"/ɪkˈspoʊz/","example":"Don't expose your skin to the sun too long.","exampleTr":"Cildini güneşe çok uzun süre maruz bırakma.","usage":"“exposed to” -e maruz kalmış; ismi “exposure”.","synonyms":["reveal","uncover"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"extend","meaning":"uzatmak, genişletmek","pos":"fiil","ipa":"/ɪkˈstend/","example":"We extended our stay by two days.","exampleTr":"Kalışımızı iki gün uzattık.","usage":"Vize/sözleşme uzatma için kullanılır; ismi “extension”.","synonyms":["lengthen","expand"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"extent","meaning":"ölçü, derece, kapsam","pos":"isim","ipa":"/ɪkˈstent/","example":"To some extent, I agree with you.","exampleTr":"Bir dereceye kadar sana katılıyorum.","usage":"“to some extent” bir ölçüde; akademik yazıda yaygındır.","synonyms":["degree","scope"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"external","meaning":"dış, harici","pos":"sıfat","ipa":"/ɪkˈstɜːrnl/","example":"I bought an external hard drive.","exampleTr":"Harici bir hard disk aldım.","usage":"Zıt anlamlısı “internal”.","synonyms":["outside","outer"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"extraordinary","meaning":"olağanüstü","pos":"sıfat","ipa":"/ɪkˈstrɔːrdəneri/","example":"She has an extraordinary voice.","exampleTr":"Olağanüstü bir sesi var.","usage":"Okunuşta “a” genelde zayıflar: “ik-STROR-dı-ne-ri”.","synonyms":["remarkable","amazing"],"topics":["duygular"]},
  {"term":"facility","meaning":"tesis; imkân","pos":"isim","ipa":"/fəˈsɪləti/","example":"The hotel has great sports facilities.","exampleTr":"Otelin harika spor tesisleri var.","usage":"Genelde çoğul kullanılır: “facilities”.","synonyms":["amenity","center"],"topics":["seyahat"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"failure","meaning":"başarısızlık; arıza","pos":"isim","ipa":"/ˈfeɪljər/","example":"The plan was a complete failure.","exampleTr":"Plan tam bir başarısızlıktı.","usage":"Tıpta “yetmezlik”: “heart failure”; fiili “fail”.","synonyms":["defeat","breakdown"],"topics":["is"]},
  {"term":"faith","meaning":"inanç, güven","pos":"isim","ipa":"/feɪθ/","example":"I have faith in you.","exampleTr":"Sana güveniyorum.","usage":"Din anlamında da kullanılır.","synonyms":["trust","belief"],"topics":["duygular"]},
  {"term":"fault","meaning":"kusur, hata","pos":"isim","ipa":"/fɔːlt/","example":"It's not your fault.","exampleTr":"Bu senin suçun değil.","usage":"“It's my fault.” (Benim hatam.) çok yaygındır; teknik arıza için de kullanılır.","synonyms":["mistake","blame"],"topics":["gunluk"]},
