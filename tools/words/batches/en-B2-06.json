[
  {"term":"draft","meaning":"taslak; taslak hazırlamak","pos":"isim","ipa":"/dræft/","example":"I've written the first draft of my essay.","exampleTr":"Kompozisyonumun ilk taslağını yazdım.","usage":"E-postada “Drafts” taslaklar klasörüdür; “draft beer” fıçı bira.","synonyms":["outline","version"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"drag","meaning":"sürüklemek","pos":"fiil","ipa":"/dræɡ/","example":"Drag the file into the folder.","exampleTr":"Dosyayı klasöre sürükle.","usage":"“drag and drop” sürükle-bırak; konuşmada “sıkıcı şey”: “What a drag!”","synonyms":["pull","haul"],"topics":["gunluk"]},
  {"term":"dramatic","meaning":"çarpıcı; dramatik","pos":"sıfat","ipa":"/drəˈmætɪk/","example":"There has been a dramatic increase in prices.","exampleTr":"Fiyatlarda çarpıcı bir artış oldu.","usage":"Grafik yorumlarında “ani ve büyük” anlamında yaygındır.","synonyms":["sudden","striking"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"edit","meaning":"düzenlemek","pos":"fiil","ipa":"/ˈedɪt/","example":"She edits videos for YouTube.","exampleTr":"YouTube için video düzenliyor.","usage":"Metin, fotoğraf ve video düzenleme için kullanılır.","synonyms":["revise","correct"],"topics":["is"]},
  {"term":"edition","meaning":"baskı, sürüm","pos":"isim","ipa":"/ɪˈdɪʃn/","example":"This is the latest edition of the dictionary.","exampleTr":"Bu sözlüğün en son baskısı.","usage":"“limited edition” sınırlı üretim.","synonyms":["version","issue"],"topics":["okul"]},
  {"term":"elderly","meaning":"yaşlı","pos":"sıfat","ipa":"/ˈeldərli/","example":"She takes care of her elderly parents.","exampleTr":"Yaşlı anne babasına bakıyor.","usage":"“old” kelimesinin kibar hâlidir; “the elderly” yaşlılar.","synonyms":["old","aged"],"topics":["aile"]},
  {"term":"elect","meaning":"seçmek (oyla)","pos":"fiil","ipa":"/ɪˈlekt/","example":"She was elected mayor.","exampleTr":"Belediye başkanı seçildi.","usage":"İsmi “election” (seçim).","synonyms":["vote for","choose"],"topics":["akademik"]},
  {"term":"elsewhere","meaning":"başka bir yerde","pos":"zarf","ipa":"/ˈelswer/","example":"If it's full, we can eat elsewhere.","exampleTr":"Doluysa başka bir yerde yiyebiliriz.","usage":"“somewhere else” ile aynı anlamdadır.","synonyms":["somewhere else"],"topics":["gunluk"]},
  {"term":"emerge","meaning":"ortaya çıkmak","pos":"fiil","ipa":"/ɪˈmɜːrdʒ/","example":"New problems emerged during the project.","exampleTr":"Proje sırasında yeni sorunlar ortaya çıktı.","usage":"İsmi “emergence”; “emerging markets” gelişmekte olan piyasalar.","synonyms":["appear","arise"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"emotional","meaning":"duygusal","pos":"sıfat","ipa":"/ɪˈmoʊʃənl/","example":"It was a very emotional goodbye.","exampleTr":"Çok duygusal bir vedalaşmaydı.","usage":"Kişi için “duygusal, kolay duygulanan”.","synonyms":["sensitive","moving"],"topics":["duygular"]},
  {"term":"emphasis","meaning":"vurgu","pos":"isim","ipa":"/ˈemfəsɪs/","example":"The school puts emphasis on languages.","exampleTr":"Okul dillere ağırlık veriyor.","usage":"“put/place emphasis on” (-e vurgu yapmak); çoğulu “emphases”.","synonyms":["stress","focus"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"emphasize","meaning":"vurgulamak","pos":"fiil","ipa":"/ˈemfəsaɪz/","example":"The teacher emphasized the importance of reading.","exampleTr":"Öğretmen okumanın önemini vurguladı.","usage":"İngiliz yazımı “emphasise”; doğrudan nesne alır (“emphasize on” denmez).","synonyms":["stress","highlight"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"enable","meaning":"olanak sağlamak","pos":"fiil","ipa":"/ɪˈneɪbl/","example":"The app enables you to learn anywhere.","exampleTr":"Uygulama her yerde öğrenmeni sağlıyor.","usage":"“enable someone to do something” kalıbıyla kullanılır; ayarlarda “etkinleştirmek”.","synonyms":["allow","permit"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"encounter","meaning":"karşılaşmak; karşılaşma","pos":"fiil","ipa":"/ɪnˈkaʊntər/","example":"We encountered some problems on the way.","exampleTr":"Yolda bazı sorunlarla karşılaştık.","usage":"Resmî bir kelimedir; günlük dilde “come across”.","synonyms":["meet","face"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"engage","meaning":"meşgul etmek; katılmak","pos":"fiil","ipa":"/ɪnˈɡeɪdʒ/","example":"Good teachers engage their students.","exampleTr":"İyi öğretmenler öğrencilerinin ilgisini çeker.","usage":"“engage in” (bir etkinliğe katılmak).","synonyms":["involve","attract"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"ensure","meaning":"sağlamak, garantiye almak","pos":"fiil","ipa":"/ɪnˈʃʊr/","example":"Please ensure that all doors are locked.","exampleTr":"Lütfen tüm kapıların kilitli olduğundan emin olun.","usage":"“make sure” kelimesinin resmî hâlidir; “insure” (sigortalamak) ile karıştırılmamalıdır.","synonyms":["guarantee","make sure"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"enthusiasm","meaning":"coşku, heves","pos":"isim","ipa":"/ɪnˈθuːziæzəm/","example":"She talks about her job with great enthusiasm.","exampleTr":"İşinden büyük bir hevesle bahsediyor.","usage":"Sıfatı “enthusiastic”.","synonyms":["passion","excitement"],"topics":["duygular"]},
