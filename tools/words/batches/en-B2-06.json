  {"term":"firm","meaning":"firma; sağlam","pos":"isim","ipa":"/fɜːrm/","example":"She works for a law firm.","exampleTr":"Bir hukuk firmasında çalışıyor.","usage":"Sıfat olarak “sağlam, kararlı”: “a firm decision”.","synonyms":["company","solid"],"topics":["is"]},
