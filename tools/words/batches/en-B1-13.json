[
  {"term":"silly","meaning":"saçma, aptalca","pos":"sıfat","ipa":"/ˈsɪli/","example":"Don't be silly, of course I'll help you.","exampleTr":"Saçmalama, tabii ki sana yardım edeceğim.","usage":"“stupid” kelimesinden daha yumuşak ve sevimlidir.","synonyms":["foolish","stupid"],"topics":["duygular"]},
