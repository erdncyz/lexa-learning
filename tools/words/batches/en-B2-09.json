[
  {"term":"means","meaning":"araç, yol, yöntem","pos":"isim","ipa":"/miːnz/","example":"The bus is the cheapest means of transport.","exampleTr":"Otobüs en ucuz ulaşım aracıdır.","usage":"Tekil ve çoğulu aynıdır; “by means of” … aracılığıyla; “by all means” elbette.","synonyms":["method","way"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
