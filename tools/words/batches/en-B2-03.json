[
  {"term":"abandon","meaning":"terk etmek, bırakmak","pos":"fiil","ipa":"/əˈbændən/","example":"They had to abandon their car in the snow.","exampleTr":"Arabalarını karda bırakmak zorunda kaldılar.","usage":"Bir plandan vazgeçmek için de kullanılır: “abandon a plan”.","synonyms":["leave","desert","give up"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
