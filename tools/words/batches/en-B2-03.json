  {"term":"advance","meaning":"ilerleme; ilerlemek","pos":"isim","ipa":"/ədˈvæns/","example":"Book your tickets in advance.","exampleTr":"Biletlerinizi önceden alın.","usage":"“in advance” önceden demektir; “advances in medicine” tıptaki ilerlemeler.","synonyms":["progress","development"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
