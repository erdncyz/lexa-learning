[
  {"term":"float","meaning":"su üstünde durmak, yüzmek","pos":"fiil","ipa":"/floʊt/","example":"Wood floats on water.","exampleTr":"Tahta su üstünde durur.","usage":"Havada süzülmek için de kullanılır; zıt anlamlısı “sink”.","synonyms":["drift","hover"],"topics":["doga"]},
