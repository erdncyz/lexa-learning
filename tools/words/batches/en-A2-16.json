  {"term":"wide","meaning":"geniş","pos":"sıfat","ipa":"/waɪd/","example":"The river is very wide here.","exampleTr":"Nehir burada çok geniş.","usage":"“a wide range of” geniş bir yelpaze demektir.","synonyms":["broad"],"topics":["gunluk"]},
