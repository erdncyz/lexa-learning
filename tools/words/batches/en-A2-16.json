  {"term":"wind","meaning":"rüzgâr","pos":"isim","ipa":"/wɪnd/","example":"The wind is very strong today.","exampleTr":"Bugün rüzgâr çok sert.","usage":"Fiil olarak “sarmak, kurmak” anlamında okunuşu farklıdır: /waɪnd/.","synonyms":["breeze"],"topics":["doga"]},
  {"term":"winner","meaning":"kazanan","pos":"isim","ipa":"/ˈwɪnər/","example":"The winner gets a free trip to Paris.","exampleTr":"Kazanan Paris'e ücretsiz bir gezi kazanıyor.","usage":"Zıt anlamlısı “loser”.","synonyms":["champion"],"topics":["spor"]},
