  {"term":"working","meaning":"çalışan; çalışma","pos":"sıfat","ipa":"/ˈwɜːrkɪŋ/","example":"Working hours are from nine to five.","exampleTr":"Çalışma saatleri dokuzdan beşe kadar.","usage":"“in working order” çalışır durumda demektir.","synonyms":["employed","functioning"],"topics":["is"]},
