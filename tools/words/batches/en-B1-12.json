  {"term":"script","meaning":"senaryo, metin","pos":"isim","ipa":"/skrɪpt/","example":"The actors are reading the script.","exampleTr":"Oyuncular senaryoyu okuyor.","usage":"Yazılımda “betik” ve yazı sistemi (alfabe) anlamları da vardır.","synonyms":["screenplay","text"],"topics":["gunluk"]},
  {"term":"secondary","meaning":"ikincil; orta (okul)","pos":"sıfat","ipa":"/ˈsekənderi/","example":"She teaches at a secondary school.","exampleTr":"Bir ortaokulda öğretmenlik yapıyor.","usage":"“secondary school” orta öğretim (İngiliz).","synonyms":["minor"],"topics":["okul"]},
