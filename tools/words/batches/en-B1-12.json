  {"term":"row","meaning":"sıra","pos":"isim","ipa":"/roʊ/","example":"We sat in the front row.","exampleTr":"Ön sırada oturduk.","usage":"“in a row” art arda: “three days in a row”. İngilizcede /raʊ/ okunuşla “kavga”.","synonyms":["line"],"topics":["gunluk"]},
