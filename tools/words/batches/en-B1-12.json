  {"term":"sex","meaning":"cinsiyet","pos":"isim","ipa":"/seks/","example":"Please write your name, age and sex.","exampleTr":"Lütfen adınızı, yaşınızı ve cinsiyetinizi yazın.","usage":"Formlarda biyolojik cinsiyet için; toplumsal cinsiyet için “gender”.","synonyms":["gender"],"topics":["gunluk"]},
  {"term":"sexual","meaning":"cinsel","pos":"sıfat","ipa":"/ˈsekʃuəl/","example":"The company has strict rules against sexual harassment.","exampleTr":"Şirketin cinsel tacize karşı katı kuralları var.","usage":"Resmî ve akademik bağlamlarda kullanılır.","synonyms":[],"topics":["akademik"]},
  {"term":"sharp","meaning":"keskin; tam (saat)","pos":"sıfat","ipa":"/ʃɑːrp/","example":"Be careful, the knife is very sharp.","exampleTr":"Dikkat et, bıçak çok keskin.","usage":"Saatte “tam”: “at 9 o'clock sharp”.","synonyms":["pointed","exact"],"topics":["gunluk"]},
  {"term":"shelf","meaning":"raf","pos":"isim","ipa":"/ʃelf/","example":"Put the books back on the shelf.","exampleTr":"Kitapları rafa geri koy.","usage":"Çoğulu düzensizdir: shelf – shelves.","synonyms":["rack"],"topics":["ev"]},
  {"term":"shell","meaning":"kabuk; deniz kabuğu","pos":"isim","ipa":"/ʃel/","example":"The children collected shells on the beach.","exampleTr":"Çocuklar plajda deniz kabuğu topladı.","usage":"Yumurta ve kuruyemiş kabuğu için de kullanılır.","synonyms":["seashell"],"topics":["doga"]},
