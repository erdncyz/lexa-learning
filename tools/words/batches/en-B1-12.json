  {"term":"seed","meaning":"tohum","pos":"isim","ipa":"/siːd/","example":"We planted tomato seeds in spring.","exampleTr":"İlkbaharda domates tohumu ektik.","usage":"Meyve çekirdeği için de kullanılır.","synonyms":["grain"],"topics":["doga"]},
  {"term":"seriously","meaning":"ciddi olarak","pos":"zarf","ipa":"/ˈsɪriəsli/","example":"Are you seriously going to eat all that?","exampleTr":"Ciddi ciddi hepsini yiyecek misin?","usage":"“take something seriously” bir şeyi ciddiye almak.","synonyms":["really"],"topics":["gunluk"]},
  {"term":"servant","meaning":"hizmetçi","pos":"isim","ipa":"/ˈsɜːrvənt/","example":"The rich family had many servants.","exampleTr":"Zengin ailenin birçok hizmetçisi vardı.","usage":"“civil servant” devlet memuru demektir.","synonyms":["helper"],"topics":["is"]},
  {"term":"set","meaning":"kurmak; set, takım","pos":"fiil","ipa":"/set/","example":"Did you set the alarm?","exampleTr":"Alarmı kurdun mu?","usage":"Düzensiz fiildir: set – set – set. “set the table” sofrayı kurmak; güneş için “batmak”.","synonyms":["put","arrange"],"topics":["gunluk"]},
