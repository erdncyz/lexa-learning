[
  {"term":"religious","meaning":"dini; dindar","pos":"sıfat","ipa":"/rɪˈlɪdʒəs/","example":"Ramadan is an important religious holiday.","exampleTr":"Ramazan önemli bir dini bayramdır.","usage":"Kişi için “dindar”: “She's very religious.”","synonyms":["spiritual","faithful"],"topics":["akademik"]},
  {"term":"remain","meaning":"kalmak; olduğu gibi durmak","pos":"fiil","ipa":"/rɪˈmeɪn/","example":"Please remain seated.","exampleTr":"Lütfen yerinizde oturmaya devam edin.","usage":"“stay” kelimesinin resmî hâlidir; “It remains to be seen” (henüz belli değil).","synonyms":["stay","continue"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"remind","meaning":"hatırlatmak","pos":"fiil","ipa":"/rɪˈmaɪnd/","example":"Remind me to call my mom.","exampleTr":"Anneme telefon etmemi hatırlat.","usage":"“remind someone of something” bir şeyi çağrıştırmak; ismi “reminder”.","synonyms":["prompt"],"topics":["gunluk"]},
  {"term":"remote","meaning":"uzak; uzaktan","pos":"sıfat","ipa":"/rɪˈmoʊt/","example":"I work remotely from home.","exampleTr":"Evden uzaktan çalışıyorum.","usage":"“remote control” kumanda; “remote village” ücra köy.","synonyms":["distant","isolated"],"topics":["is"]},
  {"term":"renewable","meaning":"yenilenebilir","pos":"sıfat","ipa":"/rɪˈnuːəbl/","example":"Solar power is a renewable energy source.","exampleTr":"Güneş enerjisi yenilenebilir bir enerji kaynağıdır.","usage":"Sözleşmeler için “yenilenebilir”: “a renewable contract”.","synonyms":["sustainable"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"repeated","meaning":"tekrarlanan","pos":"sıfat","ipa":"/rɪˈpiːtɪd/","example":"Despite repeated warnings, he didn't stop.","exampleTr":"Tekrarlanan uyarılara rağmen durmadı.","usage":"Zarfı “repeatedly” (defalarca).","synonyms":["frequent","constant"],"topics":["akademik"]},
  {"term":"represent","meaning":"temsil etmek","pos":"fiil","ipa":"/ˌreprɪˈzent/","example":"She represented Turkey at the Olympics.","exampleTr":"Olimpiyatlarda Türkiye'yi temsil etti.","usage":"“simgelemek” anlamı da vardır: “The dove represents peace.”","synonyms":["stand for","symbolize"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"require","meaning":"gerektirmek","pos":"fiil","ipa":"/rɪˈkwaɪər/","example":"This job requires a lot of patience.","exampleTr":"Bu iş çok sabır gerektiriyor.","usage":"“need” kelimesinin resmî hâlidir; ismi “requirement”.","synonyms":["need","demand"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"reservation","meaning":"rezervasyon","pos":"isim","ipa":"/ˌrezərˈveɪʃn/","example":"I have a reservation for two at eight.","exampleTr":"Saat sekiz için iki kişilik rezervasyonum var.","usage":"“make a reservation” rezervasyon yapmak; “çekince” anlamı da vardır.","synonyms":["booking"],"topics":["seyahat"]},
  {"term":"resource","meaning":"kaynak","pos":"isim","ipa":"/ˈriːsɔːrs/","example":"Water is a valuable natural resource.","exampleTr":"Su değerli bir doğal kaynaktır.","usage":"“human resources (HR)” insan kaynakları.","synonyms":["supply","source"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"respect","meaning":"saygı; saygı duymak","pos":"isim","ipa":"/rɪˈspekt/","example":"Children should show respect to their elders.","exampleTr":"Çocuklar büyüklerine saygı göstermeli.","usage":"“in this respect” bu açıdan demektir.","synonyms":["regard","admire"],"topics":["duygular"]},
  {"term":"responsibility","meaning":"sorumluluk","pos":"isim","ipa":"/rɪˌspɑːnsəˈbɪləti/","example":"Taking care of a pet is a big responsibility.","exampleTr":"Evcil hayvana bakmak büyük bir sorumluluktur.","usage":"“take responsibility for” sorumluluk almak.","synonyms":["duty"],"topics":["is"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"retire","meaning":"emekli olmak","pos":"fiil","ipa":"/rɪˈtaɪər/","example":"My father retired at 60.","exampleTr":"Babam 60 yaşında emekli oldu.","usage":"İsmi “retirement” (emeklilik).","synonyms":["stop working"],"topics":["is"]},
