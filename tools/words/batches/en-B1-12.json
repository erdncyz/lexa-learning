  {"term":"risk","meaning":"risk; riske atmak","pos":"isim","ipa":"/rɪsk/","example":"Smoking increases the risk of heart disease.","exampleTr":"Sigara kalp hastalığı riskini artırır.","usage":"“take a risk” risk almak; “at risk” risk altında.","synonyms":["danger","chance"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"robot","meaning":"robot","pos":"isim","ipa":"/ˈroʊbɑːt/","example":"Robots do many jobs in factories.","exampleTr":"Robotlar fabrikalarda birçok işi yapıyor.","usage":"“robot vacuum” robot süpürge.","synonyms":["machine"],"topics":["is"]},
  {"term":"roll","meaning":"yuvarlamak; rulo","pos":"fiil","ipa":"/roʊl/","example":"The ball rolled under the car.","exampleTr":"Top arabanın altına yuvarlandı.","usage":"İsim olarak “rulo, sandviç ekmeği”: “a roll of paper”, “bread roll”.","synonyms":["turn","spin"],"topics":["gunluk"]},
  {"term":"romantic","meaning":"romantik","pos":"sıfat","ipa":"/roʊˈmæntɪk/","example":"We had a romantic dinner by the sea.","exampleTr":"Deniz kenarında romantik bir akşam yemeği yedik.","usage":"“romantic comedy” romantik komedi.","synonyms":["loving"],"topics":["duygular"]},
