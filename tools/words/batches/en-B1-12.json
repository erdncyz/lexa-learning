  {"term":"shiny","meaning":"parlak","pos":"sıfat","ipa":"/ˈʃaɪni/","example":"He bought a shiny new car.","exampleTr":"Pırıl pırıl yeni bir araba aldı.","usage":"Yüzeyler için kullanılır.","synonyms":["bright","glossy"],"topics":["gunluk"]},
