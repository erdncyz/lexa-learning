  {"term":"sample","meaning":"örnek, numune","pos":"isim","ipa":"/ˈsæmpl/","example":"The doctor took a blood sample.","exampleTr":"Doktor kan örneği aldı.","usage":"Mağazada ücretsiz deneme ürünü için de kullanılır: “free sample”.","synonyms":["example","specimen"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"sand","meaning":"kum","pos":"isim","ipa":"/sænd/","example":"The children are playing in the sand.","exampleTr":"Çocuklar kumda oynuyor.","usage":"Sayılamaz isimdir; sıfatı “sandy”.","synonyms":[],"topics":["doga"]},
