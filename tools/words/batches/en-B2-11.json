[
  {"term":"representative","meaning":"temsilci; temsil eden","pos":"isim","ipa":"/ˌreprɪˈzentətɪv/","example":"A company representative will call you.","exampleTr":"Bir şirket temsilcisi sizi arayacak.","usage":"“customer service representative” müşteri temsilcisi; sıfat olarak “temsili”.","synonyms":["agent","delegate"],"topics":["is"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"reputation","meaning":"itibar, ün","pos":"isim","ipa":"/ˌrepjuˈteɪʃn/","example":"The restaurant has a good reputation.","exampleTr":"Restoranın iyi bir ünü var.","usage":"“have a reputation for” … ile tanınmak.","synonyms":["name","image"],"topics":["is"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"requirement","meaning":"gereklilik, şart","pos":"isim","ipa":"/rɪˈkwaɪərmənt/","example":"A degree is a requirement for this job.","exampleTr":"Bu iş için diploma bir şart.","usage":"Fiili “require”.","synonyms":["need","condition"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"rescue","meaning":"kurtarmak; kurtarma","pos":"fiil","ipa":"/ˈreskjuː/","example":"Firefighters rescued the family.","exampleTr":"İtfaiyeciler aileyi kurtardı.","usage":"“rescue team” kurtarma ekibi.","synonyms":["save"],"topics":["gunluk"]},
  {"term":"reserve","meaning":"ayırtmak; yedek","pos":"fiil","ipa":"/rɪˈzɜːrv/","example":"I reserved a table for four.","exampleTr":"Dört kişilik masa ayırttım.","usage":"İsim olarak “rezerv, yedek”: “nature reserve” doğa koruma alanı.","synonyms":["book","keep"],"topics":["seyahat"]},
  {"term":"resident","meaning":"sakin, ikamet eden","pos":"isim","ipa":"/ˈrezɪdənt/","example":"Local residents are against the new road.","exampleTr":"Yerel sakinler yeni yola karşı.","usage":"Sıfat olarak “oturan, yerleşik”.","synonyms":["inhabitant","local"],"topics":["ev"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"resist","meaning":"direnmek, karşı koymak","pos":"fiil","ipa":"/rɪˈzɪst/","example":"I couldn't resist the chocolate cake.","exampleTr":"Çikolatalı pastaya dayanamadım.","usage":"İsmi “resistance”.","synonyms":["oppose","fight"],"topics":["akademik"]},
