  {"term":"root","meaning":"kök","pos":"isim","ipa":"/ruːt/","example":"We need to find the root of the problem.","exampleTr":"Sorunun kökünü bulmamız gerekiyor.","usage":"Ağaç kökü ve kelime kökü için de kullanılır.","synonyms":["origin","source"],"topics":["akademik"]},
