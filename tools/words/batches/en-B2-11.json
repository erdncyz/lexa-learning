  {"term":"rubber","meaning":"kauçuk, lastik","pos":"isim","ipa":"/ˈrʌbər/","example":"The boots are made of rubber.","exampleTr":"Botlar kauçuktan yapılmış.","usage":"İngiliz İngilizcesinde “silgi” (Amerikan: “eraser”).","synonyms":["latex"],"topics":["gunluk"]},
