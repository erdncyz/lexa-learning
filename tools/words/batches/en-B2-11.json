  {"term":"select","meaning":"seçmek","pos":"fiil","ipa":"/sɪˈlekt/","example":"Select your language from the menu.","exampleTr":"Menüden dilinizi seçin.","usage":"“choose” kelimesinin resmî hâlidir.","synonyms":["choose","pick"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"selection","meaning":"seçim; seçki","pos":"isim","ipa":"/sɪˈlekʃn/","example":"The shop has a wide selection of books.","exampleTr":"Dükkânda geniş bir kitap seçkisi var.","usage":"“natural selection” doğal seçilim.","synonyms":["choice","range"],"topics":["alisveris"]},
  {"term":"self","meaning":"benlik, kendi","pos":"isim","ipa":"/self/","example":"She's back to her normal self.","exampleTr":"Eski hâline döndü.","usage":"Bileşiklerde yaygındır: “self-confidence” özgüven.","synonyms":["identity"],"topics":["duygular"]},
