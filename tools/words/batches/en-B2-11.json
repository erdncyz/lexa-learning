  {"term":"shot","meaning":"atış; çekim; aşı","pos":"isim","ipa":"/ʃɑːt/","example":"That's a great shot!","exampleTr":"Harika bir kare!","usage":"ABD'de “aşı/iğne”: “a flu shot”; “give it a shot” denemek.","synonyms":["photo","attempt"],"topics":["gunluk"]},
