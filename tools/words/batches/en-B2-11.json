  {"term":"sector","meaning":"sektör","pos":"isim","ipa":"/ˈsektər/","example":"She works in the public sector.","exampleTr":"Kamu sektöründe çalışıyor.","usage":"“private sector” özel sektör.","synonyms":["industry","area"],"topics":["is"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"secure","meaning":"güvenli; elde etmek","pos":"sıfat","ipa":"/səˈkjʊr/","example":"Is this website secure?","exampleTr":"Bu web sitesi güvenli mi?","usage":"Fiil olarak “sağlamak, elde etmek”: “secure a job”.","synonyms":["safe","obtain"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
