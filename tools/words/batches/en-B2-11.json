  {"term":"satisfy","meaning":"memnun etmek, tatmin etmek","pos":"fiil","ipa":"/ˈsætɪsfaɪ/","example":"It's hard to satisfy every customer.","exampleTr":"Her müşteriyi memnun etmek zor.","usage":"İsmi “satisfaction”.","synonyms":["please","meet"],"topics":["is"]},
