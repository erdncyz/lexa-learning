  {"term":"resort","meaning":"tatil yeri","pos":"isim","ipa":"/rɪˈzɔːrt/","example":"Bodrum is a popular holiday resort.","exampleTr":"Bodrum popüler bir tatil beldesidir.","usage":"“as a last resort” son çare olarak.","synonyms":["holiday destination"],"topics":["seyahat"]},
  {"term":"retain","meaning":"korumak, elinde tutmak","pos":"fiil","ipa":"/rɪˈteɪn/","example":"The company wants to retain its best workers.","exampleTr":"Şirket en iyi çalışanlarını elinde tutmak istiyor.","usage":"Resmî bir kelimedir; günlük dilde “keep”.","synonyms":["keep","hold"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"reveal","meaning":"ortaya çıkarmak, açıklamak","pos":"fiil","ipa":"/rɪˈviːl/","example":"The study revealed some surprising results.","exampleTr":"Çalışma bazı şaşırtıcı sonuçları ortaya çıkardı.","usage":"Sır açıklamak için de kullanılır.","synonyms":["show","disclose"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"revolution","meaning":"devrim","pos":"isim","ipa":"/ˌrevəˈluːʃn/","example":"The internet started a revolution in communication.","exampleTr":"İnternet iletişimde bir devrim başlattı.","usage":"Sıfatı “revolutionary”.","synonyms":["change","transformation"],"topics":["akademik"]},
