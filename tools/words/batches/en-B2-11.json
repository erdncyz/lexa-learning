  {"term":"senator","meaning":"senatör","pos":"isim","ipa":"/ˈsenətər/","example":"The senator spoke to reporters.","exampleTr":"Senatör gazetecilerle konuştu.","usage":"Senato üyesidir.","synonyms":["politician"],"topics":["akademik"]},
  {"term":"senior","meaning":"kıdemli, üst düzey","pos":"sıfat","ipa":"/ˈsiːniər/","example":"She's a senior manager.","exampleTr":"Üst düzey bir yönetici.","usage":"“senior citizen” yaşlı vatandaş; zıt anlamlısı “junior”.","synonyms":["higher","older"],"topics":["is"]},
  {"term":"sensitive","meaning":"hassas, duyarlı","pos":"sıfat","ipa":"/ˈsensətɪv/","example":"I have sensitive skin.","exampleTr":"Hassas bir cildim var.","usage":"“sensible” (mantıklı) ile karıştırılmamalıdır.","synonyms":["delicate","emotional"],"topics":["duygular"]},
  {"term":"sequence","meaning":"sıra, dizi","pos":"isim","ipa":"/ˈsiːkwəns/","example":"Put the pictures in the correct sequence.","exampleTr":"Resimleri doğru sıraya koy.","usage":"“in sequence” sırayla.","synonyms":["order","series"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"session","meaning":"oturum, seans","pos":"isim","ipa":"/ˈseʃn/","example":"We have a training session on Monday.","exampleTr":"Pazartesi bir eğitim oturumumuz var.","usage":"Terapi “seansı” için de kullanılır.","synonyms":["meeting","period"],"topics":["is"]},
  {"term":"settle","meaning":"yerleşmek; halletmek","pos":"fiil","ipa":"/ˈsetl/","example":"They settled in Izmir after retiring.","exampleTr":"Emekli olduktan sonra İzmir'e yerleştiler.","usage":"“settle down” düzene girmek; “settle a bill” hesabı ödemek.","synonyms":["live","resolve"],"topics":["gunluk"]},
  {"term":"severe","meaning":"şiddetli, ağır","pos":"sıfat","ipa":"/sɪˈvɪr/","example":"He has a severe headache.","exampleTr":"Şiddetli bir baş ağrısı var.","usage":"Hava, hastalık ve cezalar için kullanılır.","synonyms":["serious","harsh"],"topics":["saglik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"shade","meaning":"gölge; ton","pos":"isim","ipa":"/ʃeɪd/","example":"Let's sit in the shade.","exampleTr":"Gölgede oturalım.","usage":"Güneşten korunulan gölgedir; renk tonu için de: “a shade of blue”.","synonyms":["shadow","tone"],"topics":["doga"]},
  {"term":"shadow","meaning":"gölge","pos":"isim","ipa":"/ˈʃædoʊ/","example":"In the evening, the shadows get longer.","exampleTr":"Akşamları gölgeler uzar.","usage":"Bir nesnenin düşürdüğü gölgedir.","synonyms":["shade"],"topics":["doga"]},
  {"term":"shallow","meaning":"sığ; yüzeysel","pos":"sıfat","ipa":"/ˈʃæloʊ/","example":"The water is shallow here, so it's safe for kids.","exampleTr":"Su burada sığ, o yüzden çocuklar için güvenli.","usage":"Kişi için “yüzeysel”; zıt anlamlısı “deep”.","synonyms":["superficial"],"topics":["doga"]},
  {"term":"shame","meaning":"utanç; yazık","pos":"isim","ipa":"/ʃeɪm/","example":"What a shame you can't come!","exampleTr":"Gelememen ne yazık!","usage":"“It's a shame…” yazık ki…","synonyms":["pity","embarrassment"],"topics":["duygular"]},
