[
  {"term":"leisure","meaning":"boş zaman","pos":"isim","ipa":"/ˈliːʒər/","example":"What do you do in your leisure time?","exampleTr":"Boş zamanlarında ne yaparsın?","usage":"“free time” kelimesinin resmî hâlidir; “leisure center” spor ve eğlence merkezi.","synonyms":["free time","relaxation"],"topics":["gunluk"]},
