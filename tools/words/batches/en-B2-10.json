[
  {"term":"permanent","meaning":"kalıcı, daimi","pos":"sıfat","ipa":"/ˈpɜːrmənənt/","example":"She's looking for a permanent job.","exampleTr":"Kalıcı bir iş arıyor.","usage":"Zıt anlamlısı “temporary” (geçici).","synonyms":["lasting","fixed"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
