[
  {"term":"contribute","meaning":"katkıda bulunmak","pos":"fiil","ipa":"/kənˈtrɪbjuːt/","example":"Everyone contributed to the project's success.","exampleTr":"Herkes projenin başarısına katkıda bulundu.","usage":"“contribute to something” kalıbıyla kullanılır; “bağış yapmak” anlamı da vardır.","synonyms":["give","add to"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"contribution","meaning":"katkı","pos":"isim","ipa":"/ˌkɑːntrɪˈbjuːʃn/","example":"Thank you for your contribution.","exampleTr":"Katkın için teşekkürler.","usage":"“make a contribution to” (-e katkı yapmak).","synonyms":["input","donation"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"convert","meaning":"dönüştürmek","pos":"fiil","ipa":"/kənˈvɜːrt/","example":"They converted the old factory into apartments.","exampleTr":"Eski fabrikayı dairelere dönüştürdüler.","usage":"“convert A into B” kalıbıyla kullanılır; para birimi çevirmek için de.","synonyms":["change","transform"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"convinced","meaning":"ikna olmuş, emin","pos":"sıfat","ipa":"/kənˈvɪnst/","example":"I'm convinced that she's telling the truth.","exampleTr":"Doğruyu söylediğine eminim.","usage":"Fiili “convince” (ikna etmek).","synonyms":["sure","certain"],"topics":["duygular"]},
