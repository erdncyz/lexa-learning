  {"term":"council","meaning":"meclis, konsey","pos":"isim","ipa":"/ˈkaʊnsl/","example":"The city council approved the new park.","exampleTr":"Belediye meclisi yeni parkı onayladı.","usage":"“counsel” (danışmanlık) ile aynı okunur.","synonyms":["committee","board"],"topics":["akademik"]},
