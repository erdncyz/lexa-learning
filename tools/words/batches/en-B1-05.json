[
  {"term":"concentrate","meaning":"konsantre olmak, odaklanmak","pos":"fiil","ipa":"/ˈkɑːnsntreɪt/","example":"I can't concentrate with the TV on.","exampleTr":"Televizyon açıkken konsantre olamıyorum.","usage":"“concentrate on something” kalıbıyla kullanılır; ismi “concentration”.","synonyms":["focus"],"topics":["okul"]},
  {"term":"conclude","meaning":"sonuçlandırmak; sonucuna varmak","pos":"fiil","ipa":"/kənˈkluːd/","example":"The study concludes that exercise improves mood.","exampleTr":"Çalışma, egzersizin ruh halini iyileştirdiği sonucuna varıyor.","usage":"Akademik yazıda “To conclude, …” (Sonuç olarak, …) yaygındır.","synonyms":["finish","decide"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
  {"term":"conclusion","meaning":"sonuç","pos":"isim","ipa":"/kənˈkluːʒn/","example":"In conclusion, technology has many benefits.","exampleTr":"Sonuç olarak teknolojinin birçok faydası var.","usage":"“come to a conclusion” sonuca varmak; “jump to conclusions” aceleyle yargıya varmak.","synonyms":["end","result"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
