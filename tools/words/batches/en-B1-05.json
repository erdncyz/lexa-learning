  {"term":"confuse","meaning":"kafasını karıştırmak","pos":"fiil","ipa":"/kənˈfjuːz/","example":"People often confuse the two words.","exampleTr":"İnsanlar bu iki kelimeyi sık sık karıştırır.","usage":"“confuse A with B” (A'yı B ile karıştırmak).","synonyms":["mix up","puzzle"],"topics":["okul"]},
