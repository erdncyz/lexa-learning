  {"term":"consist","meaning":"oluşmak","pos":"fiil","ipa":"/kənˈsɪst/","example":"The team consists of five people.","exampleTr":"Ekip beş kişiden oluşuyor.","usage":"Her zaman “consist of” şeklinde ve sürekli hâli olmadan kullanılır.","synonyms":["be made up of"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
