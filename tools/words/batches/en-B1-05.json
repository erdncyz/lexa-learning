  {"term":"consumer","meaning":"tüketici","pos":"isim","ipa":"/kənˈsuːmər/","example":"Consumers want cheaper products.","exampleTr":"Tüketiciler daha ucuz ürünler istiyor.","usage":"“consumer rights” tüketici hakları demektir.","synonyms":["customer","buyer"],"topics":["is"],"exams":["IELTS","TOEFL","YDS"]},
