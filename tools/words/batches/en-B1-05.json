  {"term":"connection","meaning":"bağlantı","pos":"isim","ipa":"/kəˈnekʃn/","example":"The internet connection is very slow.","exampleTr":"İnternet bağlantısı çok yavaş.","usage":"Aktarmalı uçuşlar için de kullanılır: “I missed my connection.”","synonyms":["link","relation"],"topics":["gunluk"]},
