  {"term":"employment","meaning":"istihdam, iş","pos":"isim","ipa":"/ɪmˈplɔɪmənt/","example":"The new factory will create employment.","exampleTr":"Yeni fabrika istihdam yaratacak.","usage":"Zıt anlamlısı “unemployment” (işsizlik).","synonyms":["work","jobs"],"topics":["is"],"exams":["IELTS","TOEFL","YDS"]},
