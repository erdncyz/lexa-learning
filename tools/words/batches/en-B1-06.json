  {"term":"editor","meaning":"editör","pos":"isim","ipa":"/ˈedɪtər/","example":"She works as an editor at a magazine.","exampleTr":"Bir dergide editör olarak çalışıyor.","usage":"Fiili “edit” (düzenlemek).","synonyms":["reviser"],"topics":["is"]},
