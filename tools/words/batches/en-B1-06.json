  {"term":"educated","meaning":"eğitimli","pos":"sıfat","ipa":"/ˈedʒukeɪtɪd/","example":"She is a well-educated woman.","exampleTr":"İyi eğitimli bir kadın.","usage":"“an educated guess” bilgiye dayalı tahmin demektir.","synonyms":["learned"],"topics":["okul"]},
