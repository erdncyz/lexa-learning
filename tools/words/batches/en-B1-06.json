[
  {"term":"economic","meaning":"ekonomik","pos":"sıfat","ipa":"/ˌekəˈnɑːmɪk/","example":"The country is facing economic problems.","exampleTr":"Ülke ekonomik sorunlarla karşı karşıya.","usage":"Ekonomiyle ilgili demektir; “ucuz, tasarruflu” anlamı için “economical”.","synonyms":["financial"],"topics":["akademik"],"exams":["IELTS","TOEFL","YDS"]},
